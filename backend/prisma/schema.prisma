generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  ADMIN
}

enum MedicationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  PAUSED
}

enum MedicationType {
  TABLET
  INJECTION
}

enum IntakeStatus {
  PENDING
  TAKEN
  MISSED
  SKIPPED
}

enum FamilyLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DocumentType {
  FORM_100
  PRESCRIPTION
  BLOOD_TEST
  CT_SCAN
  MRI_SCAN
  ULTRASOUND
  ECG
  LAB_ANALYSIS
  OTHER
}

model User {
  id            String         @id @default(cuid())
  phone         String?        @unique
  email         String?        @unique
  pinHash       String?
  firstName     String?
  lastName      String?
  role          UserRole       @default(PATIENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medications   Medication[]
  refreshTokens RefreshToken[]

  familyRequests FamilyLink[] @relation("FamilyRequester")
  familyTargets  FamilyLink[] @relation("FamilyTarget")

  medicalDocuments      MedicalDocument[] @relation("OwnerDocuments")
  medicalDocumentsAbout MedicalDocument[] @relation("SubjectDocuments")
  documentShares        DocumentShare[]

  @@map("users")
}

model FamilyLink {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FamilyRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User             @relation("FamilyTarget", fields: [targetId], references: [id], onDelete: Cascade)
  customName  String
  status      FamilyLinkStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, targetId])
  @@index([targetId, status])
  @@index([requesterId, status])
  @@map("family_links")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Medication {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dosage          String
  instructions    String?
  type            MedicationType   @default(TABLET)
  startDate       DateTime
  endDate         DateTime?
  frequencyPerDay Int
  timesOfDay      String[]
  status          MedicationStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  intakes         MedicationIntake[]

  @@index([userId])
  @@index([status])
  @@map("medications")
}

model MedicationIntake {
  id           String       @id @default(cuid())
  medicationId String
  medication   Medication   @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  takenAt      DateTime?
  status       IntakeStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  @@index([medicationId])
  @@index([scheduledAt])
  @@index([status])
  @@map("medication_intakes")
}

model MedicalDocument {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation("OwnerDocuments", fields: [userId], references: [id], onDelete: Cascade)
  forUserId    String?
  forUser      User?                 @relation("SubjectDocuments", fields: [forUserId], references: [id], onDelete: SetNull)
  documentType DocumentType
  customType   String?
  clinic       String
  studyDate    DateTime
  notes        String?
  uploadedAt   DateTime              @default(now())
  files        MedicalDocumentFile[]
  shares       DocumentShareDocument[]

  @@index([userId, studyDate(sort: Desc)])
  @@index([userId, clinic])
  @@index([userId, documentType])
  @@map("medical_documents")
}

model MedicalDocumentFile {
  id          String          @id @default(cuid())
  documentId  String
  document    MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName    String
  storagePath String
  mimeType    String
  fileSize    Int
  uploadedAt  DateTime        @default(now())

  @@index([documentId])
  @@map("medical_document_files")
}

model DocumentShare {
  id          String                  @id @default(cuid())
  createdById String
  createdBy   User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  token       String                  @unique
  expiresAt   DateTime
  createdAt   DateTime                @default(now())
  documents   DocumentShareDocument[]

  @@map("document_shares")
}

model DocumentShareDocument {
  shareId    String
  share      DocumentShare   @relation(fields: [shareId], references: [id], onDelete: Cascade)
  documentId String
  document   MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  addedAt    DateTime        @default(now())

  @@id([shareId, documentId])
  @@index([documentId])
  @@map("document_share_documents")
}
